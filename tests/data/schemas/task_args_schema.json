{
  "$defs": {
    "AcquisitionFilter": {
      "description": "Acquisition filter model.",
      "properties": {
        "acquisitions": {
          "items": {
            "type": "integer"
          },
          "title": "Acquisitions",
          "type": "array"
        },
        "mode": {
          "default": "Include",
          "enum": [
            "Include",
            "Exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "const": "Acquisition Filter",
          "default": "Acquisition Filter",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "acquisitions"
      ],
      "title": "AcquisitionFilter",
      "type": "object"
    },
    "AcquisitionOptions": {
      "description": "Acquisition options for conversion.",
      "properties": {
        "axes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axes"
        },
        "channels": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ChannelInfoUI"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "condition_table_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Table Path"
        },
        "data_type": {
          "$ref": "#/$defs/DataTypeEnum",
          "default": "autodetect",
          "title": "Data Type"
        },
        "filters": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "Acquisition Filter": "#/$defs/AcquisitionFilter",
                "Attribute Filter": "#/$defs/AttributeFilter",
                "Channel Filter": "#/$defs/ChannelFilter",
                "FOV Name Filter": "#/$defs/FovNameFilter",
                "Path Regex Filter": "#/$defs/RegexFilter",
                "Time Range Filter": "#/$defs/TRangeFilter",
                "Well Filter": "#/$defs/WellFilter",
                "Z Range Filter": "#/$defs/ZRangeFilter"
              },
              "propertyName": "name"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RegexFilter"
              },
              {
                "$ref": "#/$defs/WellFilter"
              },
              {
                "$ref": "#/$defs/FovNameFilter"
              },
              {
                "$ref": "#/$defs/AcquisitionFilter"
              },
              {
                "$ref": "#/$defs/AttributeFilter"
              },
              {
                "$ref": "#/$defs/ChannelFilter"
              },
              {
                "$ref": "#/$defs/ZRangeFilter"
              },
              {
                "$ref": "#/$defs/TRangeFilter"
              }
            ]
          },
          "title": "Filters",
          "type": "array"
        },
        "pixel_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelSizeModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Size Information"
        },
        "stage_orientation": {
          "$ref": "#/$defs/StageOrientation",
          "default": {
            "flip_x": false,
            "flip_y": false,
            "swap_xy": false
          },
          "title": "Stage Orientation"
        }
      },
      "title": "AcquisitionOptions",
      "type": "object"
    },
    "AttributeFilter": {
      "description": "Attribute filter model.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "mode": {
          "default": "Include",
          "enum": [
            "Include",
            "Exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "const": "Attribute Filter",
          "default": "Attribute Filter",
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {
            "discriminator": {
              "mapping": {
                "Bool": "#/$defs/BoolValue",
                "Float": "#/$defs/FloatValue",
                "Integer": "#/$defs/IntValue",
                "Is None": "#/$defs/IsNoneValue",
                "Is Not None": "#/$defs/IsNotNoneValue",
                "String": "#/$defs/StringValue"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BoolValue"
              },
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/IntValue"
              },
              {
                "$ref": "#/$defs/FloatValue"
              },
              {
                "$ref": "#/$defs/IsNoneValue"
              },
              {
                "$ref": "#/$defs/IsNotNoneValue"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "key",
        "values"
      ],
      "title": "AttributeFilter",
      "type": "object"
    },
    "AutoTiling": {
      "description": "Missing description for AutoTiling.",
      "properties": {
        "mode": {
          "const": "Auto",
          "default": "Auto",
          "title": "Mode",
          "type": "string"
        },
        "tolerance": {
          "default": 1,
          "minimum": 0,
          "title": "Tiling Tolerance (in pixels)",
          "type": "number"
        }
      },
      "title": "AutoTiling",
      "type": "object"
    },
    "BackendType": {
      "description": "Missing description for BackendType.",
      "enum": [
        "anndata",
        "json",
        "csv",
        "parquet"
      ],
      "title": "BackendType",
      "type": "string"
    },
    "BoolValue": {
      "description": "Bool value for attribute filters.",
      "properties": {
        "type": {
          "const": "Bool",
          "default": "Bool",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "default": true,
          "title": "Value",
          "type": "boolean"
        }
      },
      "title": "BoolValue",
      "type": "object"
    },
    "ChannelFilter": {
      "description": "Channel filter model.",
      "properties": {
        "channel_labels": {
          "items": {
            "type": "string"
          },
          "title": "Channel Labels",
          "type": "array"
        },
        "mode": {
          "default": "Include",
          "enum": [
            "Include",
            "Exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "const": "Channel Filter",
          "default": "Channel Filter",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "channel_labels"
      ],
      "title": "ChannelFilter",
      "type": "object"
    },
    "ChannelInfoUI": {
      "description": "Channel information.",
      "properties": {
        "channel_label": {
          "title": "Channel Label",
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/ColorMenu",
          "default": "Auto",
          "title": "Color"
        },
        "wavelength_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wavelength Id"
        }
      },
      "required": [
        "channel_label"
      ],
      "title": "ChannelInfoUI",
      "type": "object"
    },
    "ColorMenu": {
      "description": "Missing description for ColorMenu.",
      "enum": [
        "Auto",
        "Blue (#0000FF)",
        "Red (#FF0000)",
        "Yellow (#FFFF00)",
        "Magenta (#FF00FF)",
        "Cyan (#00FFFF)",
        "Gray (#808080)",
        "Green (#00FF00)",
        "Orange (#FF8000)",
        "Purple (#8000FF)",
        "Teal (#008080)",
        "Lime (#00FF80)",
        "Amber (#FFBF00)",
        "Pink (#FF0080)",
        "Navy (#000080)",
        "Maroon (#800000)",
        "Olive (#808000)",
        "Coral (#FF7F50)",
        "Violet (#EE82EE)"
      ],
      "title": "ColorMenu",
      "type": "string"
    },
    "ConvertParallelInitArgs": {
      "description": "Arguments for the compute task.",
      "properties": {
        "converter_options": {
          "$ref": "#/$defs/ConverterOptions",
          "title": "Converter_Options"
        },
        "overwrite_mode": {
          "$ref": "#/$defs/OverwriteMode",
          "default": "No Overwrite",
          "title": "Overwrite_Mode"
        },
        "tiled_image_json_dump_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiled Image Json Dump Url"
        },
        "tiled_image_json_str": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiled Image Json Str"
        }
      },
      "required": [
        "converter_options"
      ],
      "title": "ConvertParallelInitArgs",
      "type": "object"
    },
    "ConverterOptions": {
      "additionalProperties": false,
      "description": "Options for the OME-Zarr conversion process.",
      "properties": {
        "grouping": {
          "default": {
            "mode": "Mosaic",
            "tiling_strategy": {
              "mode": "Auto",
              "tolerance": 1.0
            }
          },
          "discriminator": {
            "mapping": {
              "Mosaic": "#/$defs/MosaicGrouping",
              "Per-FOV": "#/$defs/PerFovGrouping"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MosaicGrouping"
            },
            {
              "$ref": "#/$defs/PerFovGrouping"
            }
          ],
          "title": "Grouping"
        },
        "omezarr_options": {
          "$ref": "#/$defs/OmeZarrOptions",
          "default": {
            "chunks": {
              "c_chunk": 1,
              "mode": "Same as FOV",
              "t_chunk": 1,
              "xy_scaling": "1",
              "z_chunk": 10
            },
            "ngff_version": "0.4",
            "num_levels": 5,
            "table_backend": "csv"
          },
          "title": "OME-Zarr Options"
        },
        "runtime_settings": {
          "$ref": "#/$defs/RuntimeSettings",
          "default": {
            "dask_scheduler": {
              "mode": "Default"
            },
            "temp_json_options": {
              "max_in_memory_bytes": 10485760,
              "serialization": "Auto",
              "temp_url": "{zarr_dir}/_tmp_json"
            },
            "use_zarrs_codec": false
          },
          "title": "Runtime Settings"
        },
        "stage_position_corrections": {
          "$ref": "#/$defs/StagePositionCorrections",
          "default": {
            "reindex_channels": true,
            "remove_t_offset": "Global",
            "remove_xy_jitter": true,
            "remove_xy_offset": "Global",
            "remove_z_offset": "Global"
          },
          "title": "Stage Position Corrections"
        },
        "writer_mode": {
          "$ref": "#/$defs/WriterMode",
          "default": "By FOV",
          "title": "Writer Mode"
        }
      },
      "title": "ConverterOptions",
      "type": "object"
    },
    "DataTypeEnum": {
      "description": "Data type enumeration.",
      "enum": [
        "autodetect",
        "uint8",
        "uint16",
        "uint32"
      ],
      "title": "DataTypeEnum",
      "type": "string"
    },
    "DefaultScheduler": {
      "additionalProperties": false,
      "description": "Do not set a Dask scheduler; leave it up to the caller.",
      "properties": {
        "mode": {
          "const": "Default",
          "default": "Default",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "DefaultScheduler",
      "type": "object"
    },
    "FixedSizeChunking": {
      "description": "Chunking strategy with fixed chunk sizes.",
      "properties": {
        "c_chunk": {
          "default": 1,
          "minimum": 1,
          "title": "Chunk Size for C",
          "type": "integer"
        },
        "mode": {
          "const": "Fixed Size",
          "default": "Fixed Size",
          "title": "Mode",
          "type": "string"
        },
        "t_chunk": {
          "default": 1,
          "minimum": 1,
          "title": "Chunk Size for T",
          "type": "integer"
        },
        "xy_chunk": {
          "default": 4096,
          "minimum": 1,
          "title": "Chunk Size for XY",
          "type": "integer"
        },
        "z_chunk": {
          "default": 10,
          "minimum": 1,
          "title": "Chunk Size for Z",
          "type": "integer"
        }
      },
      "title": "FixedSizeChunking",
      "type": "object"
    },
    "FloatValue": {
      "description": "Float value for attribute filters.",
      "properties": {
        "type": {
          "const": "Float",
          "default": "Float",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "FloatValue",
      "type": "object"
    },
    "FovBasedChunking": {
      "description": "Chunking strategy that matches the field of view.",
      "properties": {
        "c_chunk": {
          "default": 1,
          "minimum": 1,
          "title": "Chunk Size for C",
          "type": "integer"
        },
        "mode": {
          "const": "Same as FOV",
          "default": "Same as FOV",
          "title": "Mode",
          "type": "string"
        },
        "t_chunk": {
          "default": 1,
          "minimum": 1,
          "title": "Chunk Size for T",
          "type": "integer"
        },
        "xy_scaling": {
          "$ref": "#/$defs/Scalings",
          "default": "1",
          "title": "XY Scaling Factor"
        },
        "z_chunk": {
          "default": 10,
          "minimum": 1,
          "title": "Chunk Size for Z",
          "type": "integer"
        }
      },
      "title": "FovBasedChunking",
      "type": "object"
    },
    "FovNameFilter": {
      "description": "FOV name filter model.",
      "properties": {
        "mode": {
          "default": "Include",
          "enum": [
            "Include",
            "Exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "const": "FOV Name Filter",
          "default": "FOV Name Filter",
          "title": "Name",
          "type": "string"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        }
      },
      "required": [
        "regex"
      ],
      "title": "FovNameFilter",
      "type": "object"
    },
    "InplaceTiling": {
      "description": "Missing description for InplaceTiling.",
      "properties": {
        "mode": {
          "const": "Inplace",
          "default": "Inplace",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "InplaceTiling",
      "type": "object"
    },
    "IntValue": {
      "description": "Int value for attribute filters.",
      "properties": {
        "type": {
          "const": "Integer",
          "default": "Integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value"
      ],
      "title": "IntValue",
      "type": "object"
    },
    "IsNoneValue": {
      "description": "Matches attribute elements that are `None`.",
      "properties": {
        "type": {
          "const": "Is None",
          "default": "Is None",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "IsNoneValue",
      "type": "object"
    },
    "IsNotNoneValue": {
      "description": "Matches attribute elements that are not `None`.",
      "properties": {
        "type": {
          "const": "Is Not None",
          "default": "Is Not None",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "IsNotNoneValue",
      "type": "object"
    },
    "MosaicGrouping": {
      "additionalProperties": false,
      "description": "Aggregate all fields of view of an acquisition into one mosaic OME-Zarr.",
      "properties": {
        "mode": {
          "const": "Mosaic",
          "default": "Mosaic",
          "title": "Mode",
          "type": "string"
        },
        "tiling_strategy": {
          "default": {
            "mode": "Auto",
            "tolerance": 1.0
          },
          "discriminator": {
            "mapping": {
              "Auto": "#/$defs/AutoTiling",
              "Inplace": "#/$defs/InplaceTiling",
              "Snap to Corners": "#/$defs/SnapToCornersTiling",
              "Snap to Grid": "#/$defs/SnapToGridTiling"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AutoTiling"
            },
            {
              "$ref": "#/$defs/SnapToGridTiling"
            },
            {
              "$ref": "#/$defs/SnapToCornersTiling"
            },
            {
              "$ref": "#/$defs/InplaceTiling"
            }
          ],
          "title": "Tiling Strategy"
        }
      },
      "title": "MosaicGrouping",
      "type": "object"
    },
    "OmeZarrOptions": {
      "additionalProperties": false,
      "description": "Options specific to OME-Zarr writing.",
      "properties": {
        "chunks": {
          "default": {
            "c_chunk": 1,
            "mode": "Same as FOV",
            "t_chunk": 1,
            "xy_scaling": "1",
            "z_chunk": 10
          },
          "discriminator": {
            "mapping": {
              "Fixed Size": "#/$defs/FixedSizeChunking",
              "Same as FOV": "#/$defs/FovBasedChunking"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FovBasedChunking"
            },
            {
              "$ref": "#/$defs/FixedSizeChunking"
            }
          ],
          "title": "Chunking Strategy"
        },
        "ngff_version": {
          "default": "0.4",
          "enum": [
            "0.4",
            "0.5"
          ],
          "title": "Ngff Version",
          "type": "string"
        },
        "num_levels": {
          "default": 5,
          "minimum": 1,
          "title": "Num Levels",
          "type": "integer"
        },
        "table_backend": {
          "$ref": "#/$defs/BackendType",
          "default": "csv",
          "title": "Table Backend"
        }
      },
      "title": "OmeZarrOptions",
      "type": "object"
    },
    "OverwriteMode": {
      "description": "Missing description for OverwriteMode.",
      "enum": [
        "No Overwrite",
        "Overwrite",
        "Extend"
      ],
      "title": "OverwriteMode",
      "type": "string"
    },
    "PerFovGrouping": {
      "additionalProperties": false,
      "description": "Write each field of view as its own OME-Zarr image (no mosaic).",
      "properties": {
        "mode": {
          "const": "Per-FOV",
          "default": "Per-FOV",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "PerFovGrouping",
      "type": "object"
    },
    "PixelSizeModel": {
      "description": "Pixel size model.",
      "properties": {
        "t_spacing": {
          "title": "T Spacing",
          "type": "number"
        },
        "xy_pixel_size": {
          "title": "Xy Pixel Size",
          "type": "number"
        },
        "z_spacing": {
          "title": "Z Spacing",
          "type": "number"
        }
      },
      "required": [
        "xy_pixel_size",
        "z_spacing",
        "t_spacing"
      ],
      "title": "PixelSizeModel",
      "type": "object"
    },
    "ProcessScheduler": {
      "additionalProperties": false,
      "description": "Use Dask's multiprocessing scheduler for parallelism.",
      "properties": {
        "mode": {
          "const": "Processes",
          "default": "Processes",
          "title": "Mode",
          "type": "string"
        },
        "num_workers": {
          "default": 8,
          "minimum": 1,
          "title": "Number of Processes",
          "type": "integer"
        }
      },
      "title": "ProcessScheduler",
      "type": "object"
    },
    "RegexFilter": {
      "description": "Path regex filter model.",
      "properties": {
        "mode": {
          "default": "Include",
          "enum": [
            "Include",
            "Exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "const": "Path Regex Filter",
          "default": "Path Regex Filter",
          "title": "Name",
          "type": "string"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        }
      },
      "required": [
        "regex"
      ],
      "title": "RegexFilter",
      "type": "object"
    },
    "RuntimeSettings": {
      "additionalProperties": false,
      "description": "Runtime knobs applied during conversion via a scoped context manager.",
      "properties": {
        "dask_scheduler": {
          "default": {
            "mode": "Default"
          },
          "discriminator": {
            "mapping": {
              "Default": "#/$defs/DefaultScheduler",
              "Processes": "#/$defs/ProcessScheduler",
              "Synchronous": "#/$defs/SynchronousScheduler",
              "Threads": "#/$defs/ThreadScheduler"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ThreadScheduler"
            },
            {
              "$ref": "#/$defs/ProcessScheduler"
            },
            {
              "$ref": "#/$defs/SynchronousScheduler"
            },
            {
              "$ref": "#/$defs/DefaultScheduler"
            }
          ],
          "title": "Dask Scheduler"
        },
        "temp_json_options": {
          "$ref": "#/$defs/TempJsonOptions",
          "default": {
            "max_in_memory_bytes": 10485760,
            "serialization": "Auto",
            "temp_url": "{zarr_dir}/_tmp_json"
          },
          "title": "Temporary JSON Options"
        },
        "use_zarrs_codec": {
          "default": false,
          "title": "Use Zarrs Codec Pipeline",
          "type": "boolean"
        }
      },
      "title": "RuntimeSettings",
      "type": "object"
    },
    "Scalings": {
      "description": "Missing description for Scalings.",
      "enum": [
        "0.25",
        "0.5",
        "1",
        "2",
        "4"
      ],
      "title": "Scalings",
      "type": "string"
    },
    "SnapToCornersTiling": {
      "description": "Missing description for SnapToCornersTiling.",
      "properties": {
        "mode": {
          "const": "Snap to Corners",
          "default": "Snap to Corners",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "SnapToCornersTiling",
      "type": "object"
    },
    "SnapToGridTiling": {
      "description": "Missing description for SnapToGridTiling.",
      "properties": {
        "mode": {
          "const": "Snap to Grid",
          "default": "Snap to Grid",
          "title": "Mode",
          "type": "string"
        },
        "tolerance": {
          "default": 1,
          "minimum": 0,
          "title": "Tiling Tolerance (in pixels)",
          "type": "number"
        }
      },
      "title": "SnapToGridTiling",
      "type": "object"
    },
    "StageOrientation": {
      "additionalProperties": false,
      "description": "Stage orientation corrections.",
      "properties": {
